<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<PackageVersion>3.0.1</PackageVersion>
		<Platforms>AnyCPU</Platforms>
		<Authors>Ollie Sharratt</Authors>
		<Copyright>Guidance Automation 2026</Copyright>
		<Description>gRPC API Components for Guidance Automation assemblies.</Description>
		<RepositoryUrl>https://github.com/Guidance-Automation/GAAPICommon</RepositoryUrl>
		<PackageId>GAAPICommon</PackageId>
		<Company>Guidance Automation LTD</Company>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeHttpRuleProtos>true</IncludeHttpRuleProtos>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.35.1" />
		<PackageReference Include="Grpc.Core" Version="2.46.6" />
		<PackageReference Include="Grpc.Tools" Version="2.83.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Google.Api.CommonProtos" Version="2.17.0" />
		<PackageReference Include="Microsoft.AspNetCore.Grpc.JsonTranscoding" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="OpenApi\**\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackageCopyToOutput>true</PackageCopyToOutput>
			<PackagePath>contentFiles\any\any\OpenApi\</PackagePath>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<_OpenApiGenerationInput Include="Protos\**\*.proto" />
		<_OpenApiGenerationInput Include="..\scripts\Generate-OpenApi.ps1" />
		<_OpenApiGenerationOutput Include="OpenApi\Services\Agents\AgentService.swagger.json" />
		<_OpenApiGenerationOutput Include="OpenApi\Services\FleetManager\FleetManagerService.swagger.json" />
		<_OpenApiGenerationOutput Include="OpenApi\Services\Jobs\JobBuilderService.swagger.json" />
		<_OpenApiGenerationOutput Include="OpenApi\Services\Jobs\JobsStateService.swagger.json" />
		<_OpenApiGenerationOutput Include="OpenApi\Services\Jobs\JobStateService.swagger.json" />
		<_OpenApiGenerationOutput Include="OpenApi\Services\Jobs\TaskStateService.swagger.json" />
		<_OpenApiGenerationOutput Include="OpenApi\Services\Maps\MapService.swagger.json" />
		<_OpenApiGenerationOutput Include="OpenApi\Services\Scheduling\SchedulingService.swagger.json" />
		<_OpenApiGenerationOutput Include="OpenApi\Services\Servicing\ServicingService.swagger.json" />
	</ItemGroup>

	<Target Name="GenerateOpenApiDocuments"
			BeforeTargets="Pack"
			Inputs="@(_OpenApiGenerationInput)"
			Outputs="@(_OpenApiGenerationOutput)">
		<Exec
			Command="pwsh -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\Generate-OpenApi.ps1&quot;"
			WorkingDirectory="$(MSBuildProjectDirectory)\.." />
	</Target>

	<ItemGroup>
		<Protobuf Include="Protos\Common\**\*.proto" Exclude="Protos\google\**" GrpcServices="None" ProtoRoot="Protos\" />
		<Protobuf Include="Protos\Enums\**\*.proto" Exclude="Protos\google\**" GrpcServices="None" ProtoRoot="Protos\" />
		<Protobuf Include="Protos\Messages\**\*.proto" Exclude="Protos\google\**" GrpcServices="None" ProtoRoot="Protos\" />
		<Protobuf Include="Protos\Services\**\*.proto" Exclude="Protos\google\**" GrpcServices="Both" ProtoRoot="Protos\" />

		<Content Include="Protos\**\*.proto">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Protos\Services\Agents\" />
		<Folder Include="Protos\Services\Maps\" />
		<Folder Include="Protos\Services\FleetManager\" />
		<Folder Include="Protos\Services\Servicing\" />
		<Folder Include="Protos\Services\Scheduling\" />
	</ItemGroup>

</Project>
